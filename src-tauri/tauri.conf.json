{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Feed",
  "version": "0.1.0",
  "identifier": "app.thefeed.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "The Feed", "width": 480, "height": 720, "minWidth": 360, "minHeight": 480 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
